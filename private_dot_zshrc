typeset -U path PATH

for user_bin in "$HOME/.local/bin" "$HOME/bin" "$HOME/.asdf/shims"; do
  [[ -d "$user_bin" ]] && path=("$user_bin" $path)
done

export N_PREFIX="$HOME/.n"
[[ -d "$N_PREFIX/bin" ]] && path=("$N_PREFIX/bin" $path)

export ZSH="$HOME/.oh-my-zsh"
export DISABLE_AUTO_TITLE=true
export GIT_EDITOR=vim
export GIT_SEQUENCE_EDITOR=vim

if (( $+commands[code] )); then
  export EDITOR=code
else
  export EDITOR=vim
fi

alias c=clear
alias g=git
alias gpatch='git apply my.patch'
alias rmf='rm -rf'
alias rmfn='rm -rf node_modules package-lock.json'
alias reload='source ~/.zshrc'

mkcd() {
  [[ $# -eq 1 ]] || {
    print -u2 'usage: mkcd <directory>'
    return 2
  }

  mkdir -p -- "$1" && cd -- "$1"
}

killport() {
  local port="${1:-}"
  local -a pids

  [[ -n "$port" ]] || {
    print -u2 'usage: killport <port>'
    return 2
  }

  pids=($(lsof -ti :"$port" 2>/dev/null))
  (( ${#pids[@]} )) || {
    print "no processes found on port $port"
    return 0
  }

  kill -- "${pids[@]}"
}
alias kp=killport

dot-add() {
  chezmoi add -- "$@"
}

dot-save() {
  local message="${1:-chore(dotfiles): sync}"
  local source_dir staged staged_names
  local auth_marker='_'
  local token_prefix='sk'
  local private_marker='PRIVATE'
  local corporate_prefix='EUTP'
  local session_prefix='PORA'

  (( $+commands[chezmoi] )) || {
    print -u2 'chezmoi is not installed'
    return 127
  }

  chezmoi re-add || return
  source_dir=$(chezmoi source-path) || return
  git -C "$source_dir" add -A || return

  if git -C "$source_dir" diff --cached --quiet; then
    print 'dotfiles: no changes'
    return 0
  fi

  git -C "$source_dir" diff --cached --check || return
  staged_names=$(git -C "$source_dir" diff --cached --name-only)
  if print -r -- "$staged_names" | grep -Eq '(^|/)private_dot_config/zsh/secrets\.zsh$'; then
    print -u2 'dotfiles: plaintext secrets.zsh detected; push aborted'
    return 1
  fi

  staged=$(git -C "$source_dir" diff --cached --no-ext-diff --unified=0 \
    | grep '^+' \
    | grep -v '^+++' || true)
  if print -r -- "$staged" | grep -Eq "(${auth_marker}authToken=|BEGIN (OPENSSH |RSA |EC )?${private_marker} KEY|(^|[^[:alnum:]_])${token_prefix}-[[:alnum:]_-]{20,}|${corporate_prefix}_TOKEN=|${session_prefix}_SESSION=)"; then
    print -u2 'dotfiles: possible secret detected; push aborted'
    return 1
  fi

  git -C "$source_dir" commit -m "$message" && git -C "$source_dir" push
}

plugins=(git sudo)
[[ -d "$ZSH/custom/plugins/zsh-autosuggestions" ]] && plugins+=(zsh-autosuggestions)
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

if (( $+commands[eza] )); then
  alias l='eza -la --icons=always --group-directories-first'
  alias ls='eza --icons=always --group-directories-first'
fi

(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
[[ -r "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"

[[ -r "$HOME/.config/zsh/secrets.zsh" ]] && source "$HOME/.config/zsh/secrets.zsh"
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
